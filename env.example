# Copy to .env (gitignored) or export these directly. Nothing site-specific is
# ever committed to this repo -- no portal URL, no item ids, no service URLs.
#
#   Windows PowerShell:  $env:ARCGIS_PORTAL_URL = "https://..."
#   bash/zsh:            export ARCGIS_PORTAL_URL="https://..."

# --- required ---------------------------------------------------------------
# Portal root, with no trailing /sharing/rest.
#   ArcGIS Online:  https://<org>.maps.arcgis.com
#   Enterprise:     https://gis.example.gov/portal
ARCGIS_PORTAL_URL=

# --- auth (pick one) --------------------------------------------------------
# An anonymous crawl sees only public items and will silently under-report,
# so `doctor` warns about it. Use a read-only service account where possible.
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# ...or a pre-obtained token instead of username/password:
ARCGIS_TOKEN=

# --- TLS (Enterprise behind an internal CA) ---------------------------------
# Point at your CA bundle rather than disabling verification.
ARCGIS_CA_BUNDLE=
# ARCGIS_VERIFY_SSL=false

# --- where output goes ------------------------------------------------------
# Both are gitignored. Keep them that way: a real crawl result is a complete map
# of an organization's GIS attack surface.
ARCGIS_DB=output/inventory.sqlite
ARCGIS_OUTPUT_DIR=output

# --- politeness -------------------------------------------------------------
# A 5,000-item org is somebody's production portal.
ARCGIS_MAX_RPS=8
ARCGIS_PAGE_SIZE=100
ARCGIS_TIMEOUT=30
ARCGIS_MAX_RETRIES=3

# Probe service endpoints for reachability. Off by default: it multiplies the
# request count and reaches hosts outside the portal.
ARCGIS_PROBE_SERVICES=false

# Directory of user-supplied YAML rule files, overriding the shipped defaults.
ARCGIS_RULES_DIR=
